# Keeps the vedei daemon running so each hook call costs a socket round trip
# instead of compiling 417 rules. Copy to ~/.config/systemd/user/ and fix the
# path to your binary (`which vedei`).
#
#   systemctl --user enable --now vedei
#
# A user unit, not a system one: the socket is per-user by design, and the
# daemon should have exactly the reach of the person whose agent it serves.

[Unit]
Description=vedei redaction daemon
Documentation=https://github.com/mkmuniz/vedei

[Service]
ExecStart=%h/go/bin/vedei daemon
Restart=on-failure
RestartSec=2

# The daemon reads nothing from disk and writes nothing but its socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=vedei
RuntimeDirectoryMode=0700

[Install]
WantedBy=default.target
