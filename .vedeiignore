648782aa9ca9e35c33bddea812bb255f  # generated CNH vector
2040ad664a71a504a6ff863b0b78a4f0  # generated PIS vector, space-separated
4d4eb30077a44f6a1e088b2c4cff6f1d  # generated PIS vector
62949e15935851bd24d617292e7230f8  # generated titulo vector, space-separated
f60e47e7fe914c3e5d10a9b2a99d8b96  # generated titulo vector
ec2a7642f9821664294f09e54573ca66  # generated CNS vector
