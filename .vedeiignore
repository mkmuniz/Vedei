e901dbbb99a1ba293aee61bf533bb180  # **.***.***/****-35 - 7x, detect/br/cnpj_test.go and 5 more
3e210b2f70e511a859c255d442cc346a  # **.***.***/****-81 - 12x, detect/br/cnpj_test.go and 6 more
e186e56ca5d2b8fda5aa3be015e79407  # **.***.***/****-91 - 1x, detect/br/cnpj_test.go

